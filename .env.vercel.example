# ==============================================================================
# TEMPLATE ENVIRONMENT VARIABLES - VERCEL DASHBOARD
# Posyandu Terpadu (Laravel Backend on Vercel Container Runtime)
# ==============================================================================
# CATATAN PENTING:
# 1. Variabel berlabel [SENSITIVE] WAJIB dicentang opsi "Sensitive" di Vercel Dashboard
#    agar tidak terlihat oleh anggota tim biasa atau terekspos di build logs.
# 2. Vercel Dashboard TIDAK melakukan interpolasi variabel (sintaks ${VAR} tidak bekerja).
#    Jangan menulis APP_URL=https://${VERCEL_URL}. Biarkan kosong; backend otomatis
#    membaca system variable VERCEL_URL jika APP_URL tidak diset.
# 3. APP_KEY untuk Preview WAJIB berbeda dari Production.
# ==============================================================================

# --- APLIKASI ---
APP_NAME="Posyandu Terpadu"
APP_ENV=preview
# [SENSITIVE] Generate khusus preview via: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Biarkan kosong di Preview agar runtime otomatis menggunakan https://$VERCEL_URL
APP_URL=
LOG_CHANNEL=stderr

# --- DATABASE (NEON POSTGRESQL PREVIEW BRANCH) ---
DB_CONNECTION=pgsql
# Host dari branch Neon preview (misal: ep-bold-forest-123456.ap-southeast-1.aws.neon.tech)
DB_HOST=
DB_PORT=5432
# Nama database preview (DILARANG mengandung kata 'prod' atau 'production')
DB_DATABASE=neondb
# [SENSITIVE]
DB_USERNAME=
# [SENSITIVE]
DB_PASSWORD=
# Neon mewajibkan SSL
DB_SSLMODE=require
# False default. Neon pooler mendukung prepared statements. Jika emulasi diaktifkan (true),
# perhatikan casting tipe boolean PostgreSQL.
DB_EMULATE_PREPARES=false

# --- STATELESS DRIVERS (VERCEL SERVERLESS/CONTAINER READY) ---
# Menggunakan tabel 'cache' dan 'cache_locks' di PostgreSQL
CACHE_STORE=database
# Stateless API murni dengan Bearer token (tidak butuh storage/cookies)
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
# Driver array mencegah token reset password tercetak ke stderr container logs
MAIL_MAILER=array

# --- SANCTUM AUTHENTICATION ---
# Biarkan KOSONG. Posyandu Terpadu menggunakan otentikasi Bearer Token (Authorization: Bearer <token>),
# bukan otentikasi SPA berbasis Cookie/Session. SANCTUM_STATEFUL_DOMAINS hanya untuk cookie auth.
SANCTUM_STATEFUL_DOMAINS=
